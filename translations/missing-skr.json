      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_mosaic_virus.steps.1",
      "english": "Remove and destroy infected plants.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_mosaic_virus.steps.2",
      "english": "Control aphid vectors and weeds.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_septoria.causes",
      "english": "A fungus (Septoria lycopersici) causing small tan spots with dark borders on older leaves.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_septoria.name",
      "english": "Tomato septoria leaf spot",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_septoria.steps.0",
      "english": "Rotate crops and mulch to prevent soil splash.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_septoria.steps.1",
      "english": "Apply a fungicide (mancozeb or chlorothalonil) at first sign.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_septoria.steps.2",
      "english": "Remove and destroy infected lower leaves.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_spider_mites.causes",
      "english": "Tiny spider-like mites (Tetranychus urticae) that suck leaf juices, leaving stippled, bronzed leaves and fine webbing.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_spider_mites.name",
      "english": "Tomato spider mites",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_spider_mites.steps.0",
      "english": "Hose off mites with a strong spray of water early in the day.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_spider_mites.steps.1",
      "english": "Release beneficial insects (ladybugs, lacewings) or apply neem oil.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_spider_mites.steps.2",
      "english": "Avoid broad-spectrum insecticides that kill natural predators.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_target_spot.causes",
      "english": "A fungus (Corynespora cassiicola) causing dark concentric 'target' spots on leaves, favoured by warm, humid weather.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_target_spot.name",
      "english": "Tomato target spot",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_target_spot.steps.0",
      "english": "Improve air circulation by pruning lower leaves and staking plants.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_target_spot.steps.1",
      "english": "Apply a fungicide (azoxystrobin or chlorothalonil) when spots first appear.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_target_spot.steps.2",
      "english": "Water at the base early in the day.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_ylcv.causes",
      "english": "A virus spread by whiteflies, causing yellowing and curling of leaves and stunted growth.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_ylcv.name",
      "english": "Tomato yellow leaf curl virus",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_ylcv.steps.0",
      "english": "Control whiteflies with reflective mulches and insecticides at transplant.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_ylcv.steps.1",
      "english": "Remove and destroy infected plants — there is no cure.",
      "translated": ""
    },
    {
      "key": "app.detect.disease.tomato_ylcv.steps.2",
      "english": "Use resistant varieties and control weeds that host whiteflies.",
      "translated": ""
