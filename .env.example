# Neon Lakebase Postgres — pooled connection for the app.
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Neon Lakebase Postgres — direct/unpooled connection for migrations and one-off scripts.
# Use the "UNPOOLED" connection string from the Neon console.
DATABASE_URL_UNPOOLED=

# HS256 signing key for auth passes (verify / reset / session cookies).
# Minimum 16 characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Demo fallback gate (FR17): the verification-code banner renders ONLY when
# SMTP is unconfigured AND DEMO_MODE=true. NEVER set true in production.
DEMO_MODE=

# AI Advisor — LLM provider configuration (model-agnostic per FR-12)
# Supports any OpenAI-compatible API (OpenAI, Azure, local via LiteLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ADVISOR_MODEL=gpt-4o-mini

# Weather Advisory — OpenWeather 5-day / 3-hour forecast (Free Weather API access, no card).
# Endpoint used: https://api.openweathermap.org/data/2.5/forecast (lat/lon based).
# Do NOT use the deprecated One Call 2.5, or the paid One Call 3.0/4.0 subscriptions.
# A newly created free key activates automatically within ~2 hours of signup.
OPENWEATHER_API_KEY=

# Knowledge-base embeddings — generated LOCALLY via Ollama (free, no API key).
# The seeder (npm run seed:knowledge) calls Ollama's /api/embed endpoint, so a
# running Ollama daemon with the model pulled is required. The vector dimension
# must match db/migrations/0006_local-embeddings.sql (nomic-embed-text = 768).
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# AI Crop Detection
HUGGINGFACE_API_KEY=

# Cloudinary — scan image storage (FR-6.8)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mandi Price Tracker — scraper ingest authentication (FR-003, plan §Technical Context).
# The free GitHub Actions cron (`.github/workflows/mandi-cron.yml`) sends this as
# `Authorization: Bearer $PRICES_CRON_SECRET` on every POST to /api/prices/ingest.
# Mismatch → 401. Per-IP rate limit (10/min) enforced server-side.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRICES_CRON_SECRET=
