SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key — server-side scripts only (e.g. npm run sync:translations).
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# HS256 signing key for auth passes (verify / reset / session cookies).
# Minimum 16 characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Demo fallback gate (FR17): the verification-code banner renders ONLY when
# SMTP is unconfigured AND DEMO_MODE=true. NEVER set true in production.
DEMO_MODE=
